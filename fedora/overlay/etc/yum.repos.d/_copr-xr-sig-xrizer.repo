[copr:copr.fedorainfracloud.org:group_xr-sig:xrizer]
name=Copr repo for xrizer owned by @xr-sig (Fedora XR SIG)
baseurl=https://download.copr.fedorainfracloud.org/results/@xr-sig/xrizer/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=True
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/@xr-sig/xrizer/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
