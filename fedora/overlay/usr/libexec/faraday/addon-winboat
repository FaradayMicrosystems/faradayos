#!/bin/bash
# FaradayOS add-on (runs as root from install-addons-system): WinBoat, Windows apps in a small Windows VM.
# Uses Podman (Fedora's own container tool, no extra user group needed) and FreeRDP 3.
set -euo pipefail
STEP="starting"; step(){ STEP="$1"; echo "== $1"; }
trap 'echo "FAILED while: $STEP"' ERR
step "Installing Podman, podman-compose and FreeRDP"
dnf -y install podman podman-compose freerdp
step "Finding the latest WinBoat release"
# Read the release page (no GitHub API: its rate limit can block the download)
LATEST=$(curl -fsSLI --retry 5 -o /dev/null -w '%{url_effective}' https://github.com/TibixDev/winboat/releases/latest)
URL=$(curl -fsSL --retry 5 "${LATEST/\/tag\//\/expanded_assets\/}" | grep -oE '/[^"]+/releases/download/[^"]+x86_64\.rpm' | head -1 || true)
[ -n "$URL" ] && URL="https://github.com$URL"
[ -n "$URL" ] || { echo "No WinBoat .rpm found in the latest release"; false; }
step "Installing WinBoat ($URL)"
dnf -y install "$URL"
[ -e /dev/kvm ] || echo "NOTE: /dev/kvm is missing. Turn on virtualization (VT-x / AMD-V / SVM) in the BIOS, or WinBoat cannot start Windows."
echo "WinBoat installed. Open WinBoat from the app menu and choose Podman in its setup."
