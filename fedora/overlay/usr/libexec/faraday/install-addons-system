#!/bin/bash
# FaradayOS: system part of "Install FaradayOS add-ons" (runs as root via pkexec, one password for all).
# Installs the dnf and flatpak add-ons named on the command line, one at a time, from the root-owned
# list /usr/share/faraday/addons.list (only ids from that list are accepted, never commands).
# Prints "@@RESULT <id> ok|failed <exit code>" per add-on so the caller can show a summary.
set -uo pipefail
[ "$(id -u)" -eq 0 ] || { echo "Run through faraday-addons"; exit 1; }
LIST=/usr/share/faraday/addons.list
trim(){ local s=$1; s=${s#"${s%%[![:space:]]*}"}; printf '%s' "${s%"${s##*[![:space:]]}"}"; }
for want in "$@"; do
  found=0
  while IFS='|' read -r id type what label _; do
    id=$(trim "$id"); [[ -z $id || $id == \#* || $id != "$want" ]] && continue
    found=1; type=$(trim "$type"); what=$(trim "$what"); label=$(trim "$label")
    printf '\n\e[38;5;208m=== Add-on: %s ===\e[0m\n' "${label%%:*}"
    rc=0
    case $type in
      dnf) dnf -y install $what || rc=$? ;;
      flatpak)
        flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || rc=$?
        (( rc )) || flatpak install -y --noninteractive flathub $what || rc=$? ;;
      *) echo "Add-on type '$type' is not installed by this helper"; rc=2 ;;
    esac
    if (( rc == 0 )); then echo "@@RESULT $id ok 0"
    else echo "FAILED while installing add-on: ${label%%:*} (exit code $rc)"; echo "@@RESULT $id failed $rc"; fi
  done < "$LIST"
  (( found )) || { echo "Unknown add-on: $want"; echo "@@RESULT $want failed 2"; }
done
exit 0
