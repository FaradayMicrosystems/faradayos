# FaradayOS: the installer reads the live session's keyboard layout from this GNOME setting, even on KDE.
# Left empty, it resets the layout to nothing, the installer page resets it back, and the two loop forever:
# the desktop reloads its keymap nonstop (frozen mouse and touchscreen) until the installer and the session crash.
[org.gnome.desktop.input-sources]
sources=[('xkb', 'us')]
