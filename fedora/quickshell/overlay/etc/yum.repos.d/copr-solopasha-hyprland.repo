# Fallback for hyprpicker and the Hyprland screen-share portal while sdegler's Fedora 44 builds need a newer C++ runtime
[copr-solopasha-hyprland]
name=Ryoku dependency fallback: solopasha/hyprland
baseurl=https://download.copr.fedorainfracloud.org/results/solopasha/hyprland/fedora-$releasever-$basearch/
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://download.copr.fedorainfracloud.org/results/solopasha/hyprland/pubkey.gpg
includepkgs=hyprpicker xdg-desktop-portal-hyprland
skip_if_unavailable=1
