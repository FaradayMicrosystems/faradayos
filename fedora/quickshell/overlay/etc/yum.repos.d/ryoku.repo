# Ryoku desktop packages (Quickshell shell, Hyprland plugins, themes). Signed; key from the ryoku-keyring package.
[ryoku]
name=FaradayOS desktop (Ryoku packages)
baseurl=https://repo.ryoku.dev/stable/fedora/$releasever/x86_64
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-ryoku
