#!/bin/bash
# FaradayOS Quickshell edition: start one desktop.
#   desktop-session faradayos   FaradayOS desktop (Ryoku's Quickshell shell on Hyprland, or niri until Hyprland installs)
#   desktop-session plasma      KDE Plasma
# Used by the login screen (usr/share/wayland-sessions/faradayos.desktop, faradayos-plasma.desktop, run by
# SDDM through Ryoku's ryoku-wayland-session) and by a text sign-in on TTY2/TTY4 (tty-session).
set -u
gen=/usr/lib/systemd/user-environment-generators/30-systemd-environment-d-generator

case "${1:-}" in
faradayos)
  # niri needs a GPU with a 3D driver (it will not draw with software rendering): with none (no /dev/dri/renderD*,
  # e.g. a VM without 3D acceleration or a graphics card with no driver) the screen stayed black. Start KDE Plasma
  # instead, which can draw without one (VM test, v0.93e).
  if ! compgen -G "/dev/dri/renderD*" >/dev/null && [ -x /usr/bin/startplasma-wayland ]; then
    echo "desktop-session: no 3D graphics driver, starting KDE Plasma instead of the FaradayOS desktop" >&2
    exec "$0" plasma
  fi
  # Plasma may have taken Ryoku's Qt/GTK settings out of the user manager (below); put them back.
  if [ -x "$gen" ]; then
    "$gen" 2>/dev/null | grep '=' | xargs -r -d '\n' systemctl --user set-environment 2>/dev/null
  fi
  # Hyprland when installed; niri until Ryoku's Hyprland packages for Fedora install again
  if command -v Hyprland >/dev/null 2>&1; then
    export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland
    command -v start-hyprland >/dev/null 2>&1 && exec start-hyprland
    exec Hyprland
  fi
  export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=niri XDG_SESSION_DESKTOP=niri
  exec /usr/libexec/faraday/niri-session
  ;;
plasma)
  # Ryoku's settings (qt6ct theme, no window borders, its own polkit agent) would make Plasma
  # look and act wrong; drop them for this session.
  drop="QT_QPA_PLATFORMTHEME QT_WAYLAND_DISABLE_WINDOWDECORATION RYOKU_POLKIT_AGENT GSK_RENDERER QT_QPA_PLATFORM GDK_BACKEND"
  systemctl --user unset-environment $drop 2>/dev/null
  unset $drop
  export XDG_SESSION_TYPE=wayland
  if [ -x /usr/libexec/plasma-dbus-run-session-if-needed ]; then
    exec /usr/libexec/plasma-dbus-run-session-if-needed /usr/bin/startplasma-wayland
  fi
  exec /usr/bin/startplasma-wayland
  ;;
*)
  echo "usage: desktop-session faradayos|plasma" >&2
  exit 2
  ;;
esac
