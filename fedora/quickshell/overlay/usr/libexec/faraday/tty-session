#!/bin/bash
# FaradayOS Quickshell edition: text sign-in fallback (the PC starts at the graphical login screen).
#   TTY2 (Ctrl+Alt+F2): FaradayOS desktop
#   TTY4 (Ctrl+Alt+F4): KDE Plasma
# Started from the login shell (etc/profile.d/faraday-tty-session.sh and the fish equivalent)
# after a person signs in on that TTY; the live USB signs liveuser in on TTY2 by itself.
# Any other TTY stays a plain text console.
set -u
case "$(tty)" in
/dev/tty2) desktop=faradayos ;;
/dev/tty4) desktop=plasma ;;
*) exit 0 ;;
esac
# Ryoku's session launcher (the login screen runs it too): imports Ryoku's session settings, lays the
# per-user config on the first login, picks the NVIDIA or software renderer when needed.
RYOKU_WAYLAND_SESSION_DEFAULT=/nonexistent exec /usr/share/ryoku/lockscreen/ryoku-wayland-session \
  /usr/libexec/faraday/desktop-session "$desktop"
