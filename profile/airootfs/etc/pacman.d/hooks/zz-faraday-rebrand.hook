[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = filesystem
Target = lsb-release
Target = limine*
Target = cachyos-*
Target = calamares*
Target = plymouth*
Target = ubuntu-wallpapers
Target = kali-wallpapers

[Action]
Description = Re-applying FaradayOS branding...
When = PostTransaction
Exec = /bin/sh -c "/usr/share/faraday/rebrand.sh"
