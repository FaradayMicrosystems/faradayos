# FaradayOS: let the NVIDIA driver own NVIDIA cards. nouveau (the open driver) grabs the card first
# if it loads, and then the NVIDIA driver cannot. Harmless on AMD and Intel PCs.
blacklist nouveau
options nouveau modeset=0
# Needed for KDE Wayland on NVIDIA (on by default in new drivers; set so older ones match)
options nvidia-drm modeset=1 fbdev=1
options nvidia NVreg_PreserveVideoMemoryAllocations=1
#
# Save and restore all video memory allocations.
#options nvidia NVreg_PreserveVideoMemoryAllocations=1
#
# The destination should not be using tmpfs, so we prefer
# /var/tmp instead of /tmp
#options nvidia NVreg_TemporaryFilePath=/var/tmp
#
# Enable kernel suspend notifiers for open modules,
# the kernel handles video memory preservation directly
#options nvidia NVreg_UseKernelSuspendNotifiers=1
# Make a soft dependency for nvidia-uvm as adding the module loading to
# /usr/lib/modules-load.d/nvidia-uvm.conf for systemd consumption, makes the
# configuration file to be added to the initrd but not the module, throwing an
# error on plymouth about not being able to find the module.
# Ref: /usr/lib/dracut/modules.d/00systemd/module-setup.sh

# Even adding the module is not the correct thing, as we don't want it to be
# included in the initrd, so use this configuration file to specify the
# dependency.

softdep nvidia post: nvidia-uvm
/etc/dracut.conf.d:

/usr/lib/dracut/dracut.conf.d:
01-dist.conf  02-rescue.conf  50-nss-softokn.conf  90-faraday-nvidia.conf  99-nvidia-dracut.conf
initrd=initrd root=live:CDLABEL=FaradayOSv0-91e-performance rd.driver.blacklist=nouveau modprobe.blacklist=nouveau rd.live.image quiet rhgb console=tty0 console=ttyS0,115200
faraday-rebrand.service                      enabled         disabled
faraday-remove-liveuser.service              enabled         disabled
faraday-vr-setup.service                     enabled         disabled
nvidia-fallback.service                      disabled        disabled
nvidia-hibernate.service                     enabled         enabled
nvidia-powerd.service                        enabled         enabled
nvidia-resume.service                        enabled         enabled
nvidia-suspend-then-hibernate.service        enabled         enabled
nvidia-suspend.service                       enabled         enabled
